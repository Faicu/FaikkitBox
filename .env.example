# Copiază acest fișier ca ".env" și completează valorile reale.
# NU comite niciodată fișierul ".env" în git.

# --- Admin login (dashboard) ---
ADMIN_USER=admin
ADMIN_PASS=schimba-asta-cu-o-parola-puternica
# Secret pentru sesiunea de admin — minim 32 caractere aleatorii.
# Generează unul cu: openssl rand -hex 32
SESSION_SECRET=

# --- Plex ---
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=

# --- Immich ---
IMMICH_URL=http://127.0.0.1:2283
IMMICH_API_KEY=

# --- qBittorrent (WebUI) ---
QBIT_URL=http://127.0.0.1:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# --- FileList.io ---
# Passkey-ul se găsește în profilul tău Filelist → "Reset Passkey" (NU parola contului)
FILELIST_USERNAME=
FILELIST_PASSKEY=

# --- GitHub API (optional) ---
# Token fine-grained fără permisiuni speciale — ridică rate limit-ul de la 60 la 5000 req/oră
# Folosit pentru: commits recenți, verificare versiuni Immich/qBittorrent
GITHUB_TOKEN=
# Repo urmărit pentru commit-uri/webhook, format "owner/repo"
GITHUB_REPO=Faicu/FaikkitBox
# Secret configurat și în GitHub (Settings → Webhooks) pentru validarea semnăturii HMAC
GITHUB_WEBHOOK_SECRET=

# --- TMDB (Lansări / Descoperă) ---
TMDB_API_KEY=

# --- OpenSubtitles (subtitrare română automată la finalul descărcărilor) ---
# Cont gratuit pe opensubtitles.com → secțiunea "API Consumers" din profil →
# creezi o aplicație nouă, primești cheia. Vezi README pentru detalii.
OPENSUBTITLES_API_KEY=
# Opțional — necesar doar dacă limita de download anonimă (cheie fără login)
# devine insuficientă pentru volumul tău de descărcări.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# --- subs.ro (sursă de rezervă pentru subtitrări, când OpenSubtitles nu are
# o potrivire exactă de sursă/rezoluție) — cheie API din profilul tău de pe
# subs.ro, secțiunea API.
SUBSRO_API_KEY=

# --- Web Push (notificări) ---
# Generează o pereche de chei cu: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:exemplu@domeniu.tld

# --- Căi media pentru descărcări ---
MEDIA_MOVIES_PATH=/media/ssd2tb/Filme
MEDIA_SERIES_PATH=/media/ssd2tb/Seriale

# --- Glances a fost eliminat — statisticile de sistem se citesc acum direct pe host ---

# --- Cai catre docker-compose ale serviciilor Docker (pentru butoanele de restart din dashboard) ---
# Implicit: /root/plex/docker-compose.yml si /root/immich-app/docker-compose.yml
# Decomenteaza doar daca instalarea ta foloseste alte cai.
# PLEX_COMPOSE_FILE=/root/plex/docker-compose.yml
# IMMICH_COMPOSE_FILE=/root/immich-app/docker-compose.yml

# --- Agentul separat (agent/) a fost eliminat — comenzile ruleaza acum local ---

# --- Speedtest (Ookla CLI, necesita "speedtest" instalat si in PATH) ---
# Istoricul (inclusiv ultimul rezultat) se pastreaza in SQLite, nu in fisiere.
# Optional: cale completa catre binarul speedtest (recomandat daca varianta snap da erori in systemd).
# SPEEDTEST_BIN=/usr/bin/speedtest

# --- Server ---
PORT=3000
NODE_ENV=production
# Suprimă ExperimentalWarning (node:sqlite e experimental, dar stabil în uz)
NODE_OPTIONS=--disable-warning=ExperimentalWarning

# --- Căi opționale (au valori implicite sensibile, decomentează doar dacă diferă) ---
# FAIKKITBOX_DB_PATH=/opt/faikkitbox/data/faikkitbox.db
# FAIKKITBOX_REPO_DIR=/opt/faikkitbox
# FAIKKITBOX_SERVICE=faikkitbox
# ACTIVITY_LOG_PATH=/opt/faikkitbox/data/activity-log.json
# FILELIST_LOG_PATH=/opt/faikkitbox/data/filelist-downloads.json
