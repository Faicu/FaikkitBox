# Claude Remote Control pe server: câte o sesiune tmux pentru fiecare proiect.
# Sursa: /opt/faikkitbox/deploy (mutat din faikkitcar pe 24.10.2026).
# Instalare (din /opt/faikkitbox): cp deploy/claude-rc /usr/local/bin/ && cp deploy/claude.service /etc/systemd/system/
#            && systemctl daemon-reload && systemctl restart claude
# Atenție: restart-ul închide toate sesiunile Claude care rulează pe serverul tmux al serviciului.
[Unit]
Description=Claude Remote Control (faikkitbox + faikkitcar + faikkithome + faikkittiktok + faikkitvideo + bogdan)
Wants=network-online.target
After=network-online.target

[Service]
Type=forking
User=root
WorkingDirectory=/root
ExecStart=/usr/bin/tmux new-session -d -s faikkitbox -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkitbox faikkitbox"
ExecStartPost=/usr/bin/tmux new-session -d -s faikkitcar -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkitcar faikkitcar"
ExecStartPost=/usr/bin/tmux new-session -d -s faikkithome -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkithome faikkithome"
ExecStartPost=/usr/bin/tmux new-session -d -s faikkittiktok -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkittiktok faikkittiktok"
ExecStartPost=/usr/bin/tmux new-session -d -s faikkitvideo -x 200 -y 50 "/usr/local/bin/claude-rc /opt/faikkitvideo faikkitvideo"
# Bogdan: rulează ca userul neprivilegiat „bogdan”, cu contul lui Claude (în /home/bogdan/.claude);
# regulile lui sunt în /opt/bogdan/CLAUDE.md și /opt/bogdan/.claude/settings.json (root, needitabile).
ExecStartPost=/usr/bin/tmux new-session -d -s bogdan -x 200 -y 50 "/usr/sbin/runuser -u bogdan -- env XDG_RUNTIME_DIR=/run/user/1002 /usr/local/bin/claude-rc /opt/bogdan bogdan"
ExecStop=/usr/bin/tmux kill-server
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
