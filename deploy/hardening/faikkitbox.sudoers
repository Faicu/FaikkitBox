# Drepturile sudo ale contului de serviciu `faikkitbox`.
#
# Se instalează în /etc/sudoers.d/faikkitbox (mod 0440, validat cu `visudo -c`).
# Lista acoperă exact comenzile din src/lib/system/service-jobs.ts și
# src/lib/system/network-link.ts — nimic altceva. Dacă adaugi o comandă nouă în
# pagina Tehnic, trebuie adăugată și aici, altfel eșuează cu "not allowed".
#
# ATENȚIE, limita reală a acestei separări: `apt-get upgrade` prin sudo este
# echivalent cu root deplin — orice pachet rulează scripturi de instalare ca
# root. Câtă vreme butoanele de upgrade rămân în aplicație, contul dedicat
# reduce daunele accidentale, dar nu blochează un atacator decis. Scoaterea lui
# FKB_APT de mai jos e singurul mod de a închide complet calea.

# Upgrade fără întrebări: confold/confdef pentru fișierele de configurare,
# DEBIAN_FRONTEND=noninteractive (păstrat prin env_keep) pentru debconf.
# `:` și `=` se escapează în sudoers.
Cmnd_Alias FKB_APT = /usr/bin/apt-get update, \
                     /usr/bin/apt-get -y -o Dpkg\:\:Options\:\:\=--force-confdef -o Dpkg\:\:Options\:\:\=--force-confold upgrade
Defaults!FKB_APT env_keep += "DEBIAN_FRONTEND"

Cmnd_Alias FKB_SVC = /usr/bin/systemctl restart qbittorrent-nox

Cmnd_Alias FKB_DNS = /usr/bin/resolvectl flush-caches

# Butonul Restart de la Ubuntu — apare doar când /var/run/reboot-required
# există, iar serverul verifică din nou înainte să-l ruleze.
Cmnd_Alias FKB_REBOOT = /usr/bin/systemctl reboot

# Update = pull (cu serviciul pornit), apoi recreare. La Plex, --force-recreate:
# imaginea beta își instalează ultima versiune la pornirea containerului.
Cmnd_Alias FKB_PLEX = /usr/bin/docker-compose -f /root/plex/docker-compose.yml restart, \
                      /usr/bin/docker-compose -f /root/plex/docker-compose.yml pull, \
                      /usr/bin/docker-compose -f /root/plex/docker-compose.yml up -d --force-recreate

Cmnd_Alias FKB_IMMICH = /usr/bin/docker-compose -f /root/immich-app/docker-compose.yml restart, \
                        /usr/bin/docker-compose -f /root/immich-app/docker-compose.yml pull, \
                        /usr/bin/docker-compose -f /root/immich-app/docker-compose.yml up -d

# ethtool e fixat pe interfața reală: cu argument liber, `ethtool -s` poate
# reconfigura placa de rețea, ceea ce nu are legătură cu ce face aplicația.
Cmnd_Alias FKB_NET = /usr/sbin/ethtool enp2s0, \
                     /usr/bin/systemd-run --on-active=1s --unit=faikkitbox-relink --collect ethtool -r enp2s0

faikkitbox ALL=(root) NOPASSWD: FKB_APT, FKB_SVC, FKB_DNS, FKB_REBOOT, FKB_PLEX, FKB_IMMICH, FKB_NET
